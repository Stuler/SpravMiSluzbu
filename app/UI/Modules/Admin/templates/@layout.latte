      Designed by <a href="https://bootstrapmade.com/">BootstrapMade</a>
    </div>
  </footer><!-- End Footer -->

  <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

  <!-- Preloader -->
  <div id="preloader">
    <div></div>
    <div></div>
    <div></div>
    <div></div>
  </div>

  <!-- Vendor JS Files -->
  <script src="{$basePath}/assets_admin/vendor/tinymce/tinymce.min.js"></script>
  <script src="https://kit.fontawesome.com/ceef537ffd.js" crossorigin="anonymous"></script>
  <!-- Template Main JS File -->
  <script src="{$basePath}/bundle/admin.bundle.js"></script>

{/}
