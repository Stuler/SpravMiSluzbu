  ======================================================== -->
{/block}

{block #main}
	<header id="header" class="header fixed-top d-flex align-items-center">

    <div class="d-flex align-items-center justify-content-between">
      <a n:href=":Admin:Home:default" class="logo d-flex align-items-center">

        <span class="d-none d-lg-block">Bripeon Admin</span>
      </a>
      <i class="bi bi-list toggle-sidebar-btn"></i>
    </div><!-- End Logo -->

    <nav class="header-nav ms-auto">
      <ul class="d-flex align-items-center gap-3 pe-3">
        <li class="nav-item">{$_user->getIdentity()->getFullname()}</li>
        <li class="nav-item"><a n:href=":Admin:Sign:out" class="nav-link">Odhlásiť sa</a></li>
      </ul>
    </nav>

  </header><!-- End Header -->

  <!-- ======= Sidebar ======= -->
  <aside id="sidebar" class="sidebar">

    <ul class="sidebar-nav" id="sidebar-nav">

      <li class="nav-item">
        <a class="nav-link " n:href=":Admin:Home:default">
          <i class="bi bi-grid"></i>
          <span>Prevádzkový prehľad</span>
        </a>
      </li><!-- End Dashboard Nav -->

      <li class="nav-item">
        <a class="nav-link collapsed" data-bs-target="#users-nav" data-bs-toggle="collapse" href="#">
          <i class="bi bi-menu-button-wide"></i><span>Klienti</span><i class="bi bi-chevron-down ms-auto"></i>
        </a>
        <ul id="users-nav" class="nav-content collapse " data-bs-parent="#sidebar-nav">
          <li>
            <a n:href="Customer:default">
              <i class="bi bi-circle"></i><span>Zákaznící</span>
            </a>
          </li>
          <li>
            <a n:href="Provider:default">
              <i class="bi bi-circle"></i><span>Poskytovatelia</span>
            </a>
          </li>
	    </ul>
      </li><!-- End Users Nav -->

      <li class="nav-item">
        <a class="nav-link collapsed" data-bs-target="#advertisements-nav" data-bs-toggle="collapse" href="#">
          <i class="bi bi-journal-text"></i><span>Inzeráty</span><i class="bi bi-chevron-down ms-auto"></i>
        </a>
        <ul id="advertisements-nav" class="nav-content collapse " data-bs-parent="#sidebar-nav">
          <li>
            <a n:href="Advertisement:default 'supply'">
              <i class="bi bi-circle"></i><span>Ponuka</span>
            </a>
          </li>
          <li>
            <a n:href=":Admin:Demand:default">
              <i class="bi bi-circle"></i><span>Dopyt</span>
            </a>
          </li>
        </ul>
      </li><!-- End Advertisements Nav -->

      <li class="nav-item">
        <a class="nav-link collapsed" data-bs-target="#settings-nav" data-bs-toggle="collapse" href="#">
          <i class="bi bi-layout-text-window-reverse"></i><span>Nastavenia</span><i class="bi bi-chevron-down ms-auto"></i>
        </a>
        <ul id="settings-nav" class="nav-content collapse " data-bs-parent="#sidebar-nav">
          <li>
            <a n:href="CategoryAdvertisement:default">
              <i class="bi bi-circle"></i><span>Kategórie inzerátov</span>
            </a>
          </li>
          <li>
            <a n:href="CategoryService:default">
              <i class="bi bi-circle"></i><span>Kategórie služieb</span>
            </a>
          </li>
        </ul>
      </li><!-- End Settings Nav -->
	</ul>
  </aside><!-- End Sidebar-->

  <main id="main" class="main">
    <div n:foreach="$flashes as $flash" class="alert alert-{$flash->type}" role="status">{$flash->message}</div>
{*	<div class="container section-title" data-aos="fade-up">*}
		  {include #content}
{*  	</div><!-- End Section Title -->*}
  </main><!-- End #main -->


	<!-- ======= Footer ======= -->
  <footer id="footer" class="footer">
    <div class="copyright">
      &copy; Copyright <strong><span>NiceAdmin</span></strong>. All Rights Reserved
    </div>
    <div class="credits">
      <!-- All the links in the footer should remain intact. -->
      <!-- You can delete the links only if you purchased the pro version. -->
