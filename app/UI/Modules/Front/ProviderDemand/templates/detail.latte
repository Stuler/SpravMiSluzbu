{block #content}
{var $demand = $invitation->getDemand()}
<section class="bripeon-provider-signup-page"><div class="container bripeon-narrow">
<h1>Dopyt v lokalite {$demand->getCity()->getFullname()}</h1>
<p>{$demand->getStatusLabel()} · {$invitation->getResponseLabel()}</p>
<p style="white-space: pre-wrap">{$demand->getServiceSummary()}</p>
{if $invitation->getResponse() === 'accepted'}
<h2>Kontakt na zákazníka</h2>
<p>{$demand->getContactName()} · {$demand->getContactEmail()} · {$demand->getContactPhone()}</p>
<h2>Pôvodné zadanie</h2>
<p style="white-space: pre-wrap">{$demand->getDescription()}</p>
<p>Požadovaný termín: {$demand->getRequestedTerm()}</p>
{elseif $invitation->getResponse() === 'pending' && $demand->getStatus() !== 'closed' && !$demand->isMatchingStopped()}
<p>Po potvrdení záujmu získate kontaktné údaje zákazníka. Záujem môžu potvrdiť najviac tri oslovené firmy.</p>
<div class="bripeon-form-panel">{control responseForm}</div>
{/if}
<p><a n:href="default">Dopyty, dohody a recenzie</a></p>
</div></section>
