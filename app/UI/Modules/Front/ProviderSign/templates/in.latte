{block #content}
<section class="bripeon-provider-signup-page">
	<div class="container bripeon-narrow">
		<p class="bripeon-eyebrow">Pre poskytovateľov</p>
		<h1>Prihlásenie poskytovateľa</h1>

		<div class="bripeon-form-panel">
			{control signInForm}
		</div>

		<p><a n:href="up">Nemáte účet? Zaregistrujte sa</a></p>

		<details class="bripeon-resend">
			<summary>Nedostali ste aktivačný e-mail?</summary>
			<div class="bripeon-form-panel">
				{control resendActivationForm}
			</div>
		</details>
	</div>
</section>
