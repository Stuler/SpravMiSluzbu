{layout '../../Base/templates/@layout.latte'}

{block #head}
	<!-- Favicons -->
	<link href="{$basePath}/assets_front/img/favicon.png" rel="icon">
	<link href="{$basePath}/assets_front/img/apple-touch-icon.png" rel="apple-touch-icon">
	<meta name="theme-color" content="#0d6f50">

	<!-- Main CSS File (fonts are bundled, no third-party font host) -->
	<link href="{$basePath}/bundle/front.bundle.css" rel="stylesheet">
{/}

{block #main}
	{include '@icons.latte'}

	<header id="header" class="bripeon-header">
		<div class="container bripeon-header-bar">
			<a n:href="Home:" class="bripeon-logo-link" aria-label="Bripeon domov">
				<span class="bripeon-logo-mark">B</span>
				<span class="sitename">Bripeon</span>
			</a>

			<nav id="navmenu" class="bripeon-nav" aria-label="Hlavná navigácia">
				<a href="{link Home:}#ako-to-funguje">Ako to funguje</a>
				<a href="{link Home:}#sluzby">Služby</a>
				<a href="{link Home:}#dovera">Hodnotenia</a>
				<a n:href=":Front:ProviderSign:up">Pre firmy</a>

				<div class="bripeon-account">
					<button type="button" class="bripeon-account-toggle" aria-expanded="false" aria-controls="bripeon-account-menu">
						{if $_user->isProvider() || $_user->isCustomer()}Môj účet{else}Prihlásiť sa{/if}
						<svg class="bripeon-icon" aria-hidden="true"><use href="#i-chevron"/></svg>
					</button>
					<ul class="bripeon-account-menu" id="bripeon-account-menu">
						{if $_user->isProvider()}
							<li class="bripeon-account-label">Účet poskytovateľa</li>
							<li><a n:href=":Front:ProviderDashboard:default">Môj prehľad</a></li>
							<li><a n:href=":Front:ProviderDemand:default">Dopyty pre firmu</a></li>
							<li class="bripeon-nav-logout">{control providerSignOutForm}</li>
						{elseif $_user->isCustomer()}
							<li class="bripeon-account-label">Zákaznícky účet</li>
							<li><a n:href=":Front:CustomerDashboard:default">Moje dopyty</a></li>
							<li class="bripeon-nav-logout">{control providerSignOutForm}</li>
						{else}
							<li class="bripeon-account-label">Prihlásenie a registrácia</li>
							<li><a n:href=":Front:UserSign:in">Prihlásenie zákazníka</a></li>
							<li><a n:href=":Front:ProviderSign:in">Prihlásenie poskytovateľa</a></li>
							<li><a n:href=":Front:UserSign:up">Vytvoriť zákaznícky účet</a></li>
							<li><a n:href=":Front:ProviderSign:up">Registrácia poskytovateľa</a></li>
						{/if}
					</ul>
				</div>

				<a class="bripeon-button bripeon-button-primary" n:href=":Front:Demand:create">Zadať dopyt</a>
			</nav>

			<button type="button" class="bripeon-menu-toggle" aria-expanded="false" aria-controls="navmenu" aria-label="Otvoriť menu">
				<svg class="bripeon-icon bripeon-icon-open" aria-hidden="true"><use href="#i-menu"/></svg>
				<svg class="bripeon-icon bripeon-icon-close" aria-hidden="true"><use href="#i-close"/></svg>
			</button>
		</div>
	</header>

	<main role="main" class="bripeon-main">
		{include #content}
	</main>

	<footer id="footer" class="bripeon-footer">
		<div class="container bripeon-footer-grid">
			<div>
				<a n:href="Home:" class="bripeon-logo-link">
					<span class="bripeon-logo-mark">B</span>
					<span class="sitename">Bripeon</span>
				</a>
				<p>Trhovisko pre lokálne služby, ktoré spája zákazníkov s overenými poskytovateľmi.</p>
			</div>
			<div>
				<h3>Zákazníci</h3>
				<a href="{link Home:}#sluzby">Kategórie služieb</a>
				<a n:href=":Front:Demand:create">Zadať dopyt</a>
				<a href="{link Home:}#dovera">Overené hodnotenia</a>
			</div>
			<div>
				<h3>Poskytovatelia</h3>
				<a n:href="ProviderSign:up">Registrácia firmy</a>
				<a href="{link Home:}#pre-poskytovatelov">Ako získavať zákazky</a>
				<a n:href="ProviderSign:in">Prihlásenie</a>
			</div>
		</div>
		<div class="container bripeon-footer-bottom">
			<p>© <span>2026</span> <strong>Bripeon</strong>. <span>Všetky práva vyhradené.</span></p>
			<p>Služby po celom Slovensku</p>
		</div>
	</footer>

	<div class="bripeon-sticky-cta">
		<a class="bripeon-button bripeon-button-primary" n:href=":Front:Demand:create">Zadať dopyt</a>
	</div>

	<!-- Main JS File -->
	<script src="{$basePath}/bundle/front.bundle.js"></script>
{/}
