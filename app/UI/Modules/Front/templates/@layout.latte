{layout '../../Base/templates/@layout.latte'}

{block #head}
	<!-- Favicons -->
	<link href="{$basePath}/assets_front/img/favicon.png" rel="icon">
	<link href="{$basePath}/assets_front/img/apple-touch-icon.png" rel="apple-touch-icon">

	<!-- Fonts -->
	<link href="https://fonts.googleapis.com" rel="preconnect">
	<link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Open+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500;1,600;1,700;1,800&family=Montserrat:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
	<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap" rel="stylesheet">

	<!-- Main CSS File -->
	<link href="{$basePath}/bundle/front.bundle.css" rel="stylesheet">
{/}

{block #main}
	<header id="header" class="header bripeon-header sticky-top">
		<div class="branding bripeon-branding">
			<div class="container position-relative d-flex align-items-center justify-content-between">
				<a n:href="Home:" class="bripeon-logo-link d-flex align-items-center" aria-label="Bripeon domov">
					<span class="bripeon-logo-mark">B</span>
					<span class="sitename">Bripeon</span>
				</a>

				<nav id="navmenu" class="navmenu bripeon-nav">
					<ul>
						<li><a href="{link Home:}#ako-to-funguje">Ako to funguje</a></li>
						<li><a href="{link Home:}#sluzby">Služby</a></li>
						<li><a href="{link Home:}#kalkulacka">Kalkulačka</a></li>
						<li><a n:href="ProviderSign:up">Pre poskytovateľov</a></li>
						<li class="dropdown bripeon-account"><a href="#"><span>Môj účet</span><i class="bi bi-person-circle toggle-dropdown"></i></a>
							<ul>
								<li><a href="#">Prihlásiť</a></li>
								<li><a n:href="UserSign:up">Vytvoriť účet</a></li>
							</ul>
						</li>
						<li><a class="bripeon-nav-cta" href="{link Home:}#dopyt">Zadať dopyt</a></li>
					</ul>
					<i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
				</nav>
			</div>
		</div>
	</header>

	<main role="main" class="main bripeon-main">
		{include #content}
	</main>

	<footer id="footer" class="footer bripeon-footer">
		<div class="container bripeon-footer-grid">
			<div>
				<a n:href="Home:" class="bripeon-logo-link bripeon-footer-logo d-inline-flex align-items-center">
					<span class="bripeon-logo-mark">B</span>
					<span class="sitename">Bripeon</span>
				</a>
				<p>Trhovisko pre lokálne služby, ktoré spája zákazníkov s overenými poskytovateľmi.</p>
			</div>
			<div>
				<h3>Zákazníci</h3>
				<a href="{link Home:}#sluzby">Kategórie služieb</a>
				<a href="{link Home:}#kalkulacka">Orientačné ceny</a>
				<a href="{link Home:}#dopyt">Zadať dopyt</a>
			</div>
			<div>
				<h3>Poskytovatelia</h3>
				<a n:href="ProviderSign:up">Registrácia firmy</a>
				<a href="{link Home:}#pre-poskytovatelov">Ako získavať zákazky</a>
				<a href="{link Home:}#dovera">Dôvera a kvalita</a>
			</div>
		</div>
		<div class="container bripeon-footer-bottom">
			<p>© <span>2026</span> <strong>Bripeon</strong>. <span>Všetky práva vyhradené.</span></p>
		</div>
  	</footer>

  	<!-- Scroll Top -->
  <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

  <!-- Preloader -->
  <div id="preloader">
    <div></div>
    <div></div>
    <div></div>
    <div></div>
  </div>

  <!-- Vendor JS Files -->
  <script src="https://kit.fontawesome.com/ceef537ffd.js" crossorigin="anonymous"></script>
  <script src="{$basePath}/assets_front/vendor/aos/aos.js"></script>
  <script src="{$basePath}/assets_front/vendor/glightbox/js/glightbox.min.js"></script>
  <script src="{$basePath}/assets_front/vendor/purecounter/purecounter_vanilla.js"></script>
  <!-- Main JS File -->
  <script src="{$basePath}/bundle/front.bundle.js"></script>

{/}
