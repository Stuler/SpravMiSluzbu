# Copy this file to config/local.neon for local development.
# Docker copies it automatically on first start if config/local.neon is missing.

# Host Config
parameters:
	testPassword: 'change-me'
	testUrl: 'test.example.com'

	stripe:
		publicKey: 'pk_test_your_public_key'
		secretKey: 'sk_test_your_secret_key'

	# Database
	database:
		host: database
		dbname: sprav_mi_sluzbu
		user: root
		password: root
		driver: mysqli
		port: 3306
		encoding: utf8mb4

	smtp:
		host: smtp.example.com
		username: info@example.com
		password: 'change-me'
		port: 587
		secure: tls

tracy:
	bar:
		- Nextras\MailPanel\MailPanel(%tempDir%/mail-panel-latte)

services:
	nette.mailer:
		class: Nette\Mail\Mailer
		factory: Nextras\MailPanel\FileMailer(%tempDir%/mail-panel-mails)

# For 0.0.0.0 instead of localhost
# php -S 0.0.0.0:8000 -t www
